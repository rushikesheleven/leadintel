# ══════════════════════════════════════════════════════════════════════════════
# LeadIntel — Environment Configuration
# All settings are OPTIONAL. LeadIntel works with zero configuration.
# Copy this file to .env and edit as needed.
# ══════════════════════════════════════════════════════════════════════════════

# ─── OpenStreetMap / Overpass ─────────────────────────────────────────────────
# Public Overpass endpoint (free, no key required).
# Point to a self-hosted instance for production load.
# Docs: https://wiki.openstreetmap.org/wiki/Overpass_API
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Search radius in metres around a geocoded point (default 5 km).
OVERPASS_RADIUS_M=5000

# ─── Demo Mode ────────────────────────────────────────────────────────────────
# Set to "true" to disable live network calls and use synthetic demo data only.
# Useful for development and offline use.
DEMO_MODE=false

# ─── Ollama (Optional Local AI) ───────────────────────────────────────────────
# Install Ollama from https://ollama.ai, then pull a model:
#   ollama pull llama3
# Set OLLAMA_ENABLED=true to enable AI-powered summaries and scoring.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Storage ──────────────────────────────────────────────────────────────────
LEADINTEL_DB_PATH=leadintel.db

# ─── HTTP / Cache ─────────────────────────────────────────────────────────────
# In-process result cache TTL in seconds. Max 604800 (7 days) per OSM policy.
CACHE_TTL=3600
REQUEST_TIMEOUT=30.0
# Set to "false" to skip robots.txt checks (not recommended).
RESPECT_ROBOTS=true

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Optional Third-Party Providers (never required) ─────────────────────────
# Google Places API — if set, enables a richer GooglePlacesProvider (Phase 4+).
GOOGLE_PLACES_API_KEY=
# Google PageSpeed — enables check_seo enrichment (Phase 3).
PAGESPEED_API_KEY=
# Gemini AI — enables cloud AI summaries (alternative to Ollama).
GEMINI_API_KEY=
